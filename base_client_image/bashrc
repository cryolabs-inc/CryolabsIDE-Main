if [[ $- != *i* ]] ; then
	# Shell is non-interactive.  Be done now!
	return
fi

# set fallback PS1; only if currently set to upstream bash default
if [ "$PS1" = '\s-\v\$ ' ]; then
	PS1='\h:\w\$ '
fi

for f in /etc/bash/*.sh; do
	[ -r "$f" ] && . "$f"
done
unset f

# Enable colored prompt
export PS1=$(echo -ne "\[\033[1;36m\]\u\[\033[1;31m\]@\\[\033[1;32m\]\h:\[\033[1;35m\]\w\[\033[1;31m\]\$\\[\033[0m\] ")

# Enable colors for ls command
export LS_OPTS='--color=auto'
alias ls='ls ${LS_OPTS}'