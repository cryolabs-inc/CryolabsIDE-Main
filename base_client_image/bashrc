if [[ $- != *i* ]] ; then
	# Shell is non-interactive.  Be done now!
	return
fi

# set fallback PS1; only if currently set to upstream bash default
if [ "$PS1" = '\s-\v\$ ' ]; then
	PS1='\h:\w\$ '
fi

for f in /etc/bash/*.sh; do
	[ -r "$f" ] && . "$f"
done
unset f

# Enable colored prompt (red)
export PS1='\[\033[1;31m\]\u@\h:\w\$\[\033[0m\] '

# Enable colors for ls command
export LS_OPTS='--color=auto'
alias ls='ls ${LS_OPTS}'