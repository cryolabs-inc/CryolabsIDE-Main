#!/sbin/openrc-run

depend() {
    before agetty.ttyS0
}

start() {
    . /etc/profile.d/java.sh
    ip link set eth0 up
    ip link set lo up
    mkdir /dev/pts
    mount -t devpts /dev/pts /dev/pts
    mount -t 9p -o cache=none,directio host9p /root
    mount -t tmpfs /tmp /tmp
    (cd /root && HOME=/root mu &>/tmp/mu.log )  & 
    udhcpc
    sleep 0.75
    eend 0
}
